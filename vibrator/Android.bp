cc_binary {
    name: "vendor.qti.hardware.vibrator.service.oplus_aston",
    stem: "vendor.qti.hardware.vibrator.service.oplus",
    vendor: true,
    relative_install_path: "hw",
    local_include_dirs: [
        ".",
        "include",
        "effect",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-DUSE_EFFECT_STREAM",
    ],
    shared_libs: [
        "libbase",
        "libcutils",
        "liblog",
        "libutils",
        "libbinder_ndk",
    ],
    static_libs: ["android.hardware.vibrator-V1-ndk"],
    srcs: [
        "service.cpp",
        "Vibrator.cpp",
        "effect/effect.cpp",
    ],
}
