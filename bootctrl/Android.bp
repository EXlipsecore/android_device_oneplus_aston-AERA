cc_library_static {
    name: "libgptutils.qti.aston",
    recovery: true,
    export_include_dirs: ["gpt-utils"],
    local_include_dirs: [
        "gpt-utils",
        "gpt-utils/include",
    ],
    cflags: ["-D_BSG_FRAMEWORK_KERNEL_HEADERS"],
    shared_libs: [
        "libcutils",
        "liblog",
        "libz",
    ],
    srcs: [
        "gpt-utils/gpt-utils.cpp",
        "gpt-utils/recovery-ufs-bsg.cpp",
    ],
}

cc_binary {
    name: "android.hardware.boot-service.qti.recovery",
    recovery: true,
    relative_install_path: "hw",
    defaults: ["libboot_control_defaults"],
    local_include_dirs: [
        "1.1/libboot_control_qti",
        "aidl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
    ],
    shared_libs: [
        "android.hardware.boot-V1-ndk",
        "android.hardware.boot@1.1",
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "liblog",
        "libz",
    ],
    static_libs: [
        "libboot_control",
        "libbootloader_message",
        "libfstab",
        "libgptutils.qti.aston",
    ],
    srcs: [
        "1.1/libboot_control_qti/libboot_control_qti.cpp",
        "aidl/BootControl.cpp",
        "aidl/main.cpp",
    ],
    init_rc: ["aidl/android.hardware.boot-service.qti.recovery.rc"],
}
